# ICMHS Registrar Suite — environment variables
# Copy these into Vercel: Project -> Settings -> Environment Variables.
# This project merges the former "icmhsdeferment" and "icmhs-registrar-dashboard"
# apps, so it needs the union of both apps' variables. If you're pointing this
# deployment at the SAME Neon database and Google service account those apps
# already used, just copy the values straight across from their Vercel projects.

# --- Google Sheets access (shared by both modules) ---------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste with literal \n for newlines (Vercel env vars are single-line)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-sheet-id-here

# --- Postgres (Deferments module, AND now registrar_users accounts) ----------
# Set automatically if you attach a Neon integration to this Vercel project.
# If you're reusing the SAME database the old icmhsdeferment app used, copy
# its DATABASE_URL value across instead. Run lib/auth/schema.sql against this
# database once (see AUTH.md) before anyone can log in.
DATABASE_URL=

# --- Per-user login (see AUTH.md for full setup steps) -----------------------
# Signs/verifies the session cookie every registrar's login issues. Required —
# there is no default; the app refuses to start sessions without it. Use a
# long random string (e.g. `openssl rand -base64 32`) and never commit it.
SESSION_SECRET=

# --- Optional ------------------------------------------------------------
# How often term dashboards revalidate cached Sheet data, in seconds.
REVALIDATE_SECONDS=120

# --- Sept-Dec 2026 status column ---------------------------------------------
# Starting Sept-Dec 2026, that term no longer uses the STATUS LOG tab. Instead
# add a "SEPT-DEC 2026 STATUS" header to column AA on BOTH MAIN CAMPUS and
# NAKURU CAMPUS. The dashboard reads/writes that column directly for this term
# (see lib/terms.ts), and deferment approvals/denials also write here so the
# two modules always agree. Must match the column letter you actually used.
CAMPUS_STATUS_MIRROR_COLUMN=AA

# --- Graduation Cohort column -------------------------------------------------
# Add a "Graduation Cohort" header to column AD on BOTH MAIN CAMPUS and NAKURU
# CAMPUS (see lib/graduationCohort.ts). Holds the year a student graduated,
# independent of term — not something you configure here, just a sheet column
# to add once.

# --- RETIRED -------------------------------------------------------------
# DASHBOARD_USER, DASHBOARD_PASSWORD, and RESOLVE_PASSWORD are gone as of the
# per-user accounts change — every registrar now has their own account (see
# AUTH.md) instead of a site-wide shared password. Remove these from Vercel
# if they're still set; they're no longer read anywhere in the code.
